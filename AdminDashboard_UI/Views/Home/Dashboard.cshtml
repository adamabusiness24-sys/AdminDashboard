@model List<AdminDashboard_UI.Models.Products>;

@{
	ViewData["Title"] = "Dashboard";
}

<div class="text-center">
<h1 class="display-4">Admin Dashboard</h1>
</div>
<p>Welcome to admin dashboard. Here you can manage products and view stattistics</p>
<a asp-controller="Product" asp-action="AddProduct" class="btn btn-success mb-3">Add new product</a>
<div>
    <h2>Product List</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Product Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Color</th>
            </tr>
        </thead>

        <tbody>
            @{
                if(Model == null || !Model.Any())
                {
                    <tr>
						<td colspan="5" class="text-center">No products available.</td>
					</tr>
                }
            else
            {   @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.ProductId</td>
                        <td>@product.ProductName</td>
                        <td>@product.Description</td>
                        <td>@product.Price.ToString("c")</td>
                        <td>@product.color</td>
                    </tr>
            }   }
          }
          </tbody>
    </table>
</div>